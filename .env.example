# ==============================================================================
# fyntrac-py-model — Environment Variables
# ==============================================================================

# ── Service ──────────────────────────────────────────────────────────────
SERVICE_PORT=8090
SERVICE_HOST=0.0.0.0

# Caps the OS-process pool used for parallel model execution. Leave unset to
# auto-size to every core this process can see (correct for a single instance
# per host/container). Set explicitly when running more than one instance on
# the same host without per-instance CPU isolation, so they split the cores
# instead of each claiming all of them — e.g. on a 20-core box running two
# CLI instances, MAX_PROCESS_WORKERS=10 on each.
# MAX_PROCESS_WORKERS=10

# ── MongoDB ──────────────────────────────────────────────────────────────
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_USERNAME=root
MONGODB_PASSWORD=R3s3rv#313
MONGODB_AUTH_DATABASE=admin
MONGODB_DEFAULT_DATABASE=master

# ── ZITADEL / JWT ────────────────────────────────────────────────────────
ZITADEL_ISSUER_URI=https://your-zitadel-instance.zitadel.cloud
ZITADEL_PROJECT_ID=your-project-id

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3030

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
